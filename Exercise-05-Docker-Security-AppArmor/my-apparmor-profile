#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
    #include <abstractions/base>

    # Deny access to sensitive system files.
    deny /etc/** r,
    deny /var/** rw,

    # Allow network operations required by the Flask application.
    network inet stream,

    # Allow application files to be accessed and modified.
    /app/** rwk,

    # Deny execution and related access to binaries in these directories.
    deny /bin/** rmix,
    deny /usr/bin/** rmix,

    # Restrict system administration capabilities.
    capability net_bind_service,
    deny capability sys_admin,
}
